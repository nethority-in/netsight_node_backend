{
  "name": "netsight-node-server",
  "version": "1.0.0",
  "description": "Node.js server modules for NetSight application",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "predev": "node scripts/kill-port.js 3002",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:tsx": "tsx watch src/index.ts",
    "worker:notifications": "tsx src/workers/notificationWorker.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand --detectOpenHandles",
    "prisma:generate": "prisma generate",
    "prisma:generate:logs": "prisma generate --schema prisma/logs.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:push:logs": "prisma db push --schema prisma/logs.prisma"
  },
  "keywords": [
    "netsight",
    "node",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "amqplib": "^2.0.1",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.35",
    "morgan": "^1.11.0",
    "mysql2": "^3.16.0",
    "node-mailjet": "^6.0.11",
    "puppeteer": "^25.10.0",
    "twilio": "^5.12.0",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.2",
    "prisma": "^5.19.1",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
